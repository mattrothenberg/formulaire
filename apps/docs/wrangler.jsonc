{
  "$schema": "./node_modules/wrangler/config-schema.json",
  // The docs site: static assets only, no Worker code.
  "name": "formulaire-docs",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  },
  // One canonical address: no workers.dev URL and no preview URLs.
  "routes": [{ "pattern": "formulaire.mattrothenberg.com", "custom_domain": true }],
  "workers_dev": false,
  "preview_urls": false,
  "observability": { "enabled": true }
}
