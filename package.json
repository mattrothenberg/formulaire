{
  "name": "formulaire-monorepo",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.3.4",
  "scripts": {
    "dev": "pnpm --filter @formulaire/docs dev",
    "build": "pnpm --filter formulaire-ui build",
    "build:docs": "pnpm --filter @formulaire/docs build",
    "typecheck": "pnpm -r typecheck",
    "format": "prettier --write .",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "test": "pnpm --filter formulaire-ui test"
  },
  "prettier": {
    "printWidth": 80,
    "semi": true,
    "singleQuote": true,
    "trailingComma": "es5"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "prettier": "^3.9.9",
    "typescript": "^7.0.2"
  }
}
