{
  "name": "formulaire-ui",
  "version": "0.0.0",
  "description": "Dense, paper-style grid forms. A CSS core plus React components built on Base UI.",
  "author": "Matt Rothenberg",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./styles.css": "./dist/styles.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "sideEffects": [
    "*.css"
  ],
  "scripts": {
    "build": "tsdown && cp src/styles.css dist/styles.css",
    "typecheck": "tsc --noEmit",
    "example": "vite example",
    "example:build": "vite build example",
    "format": "prettier --write ."
  },
  "peerDependencies": {
    "@base-ui/react": "^1.0.0",
    "react": ">=19",
    "react-dom": ">=19"
  },
  "prettier": {
    "printWidth": 80,
    "semi": true,
    "singleQuote": true,
    "trailingComma": "es5"
  },
  "devDependencies": {
    "@base-ui/react": "^1.0.0",
    "@maskito/core": "^5.6.0",
    "@maskito/kit": "^5.6.0",
    "@maskito/phone": "^5.6.0",
    "@maskito/react": "^5.6.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "libphonenumber-js": "^1.13.14",
    "prettier": "^3.9.9",
    "react": ">=19",
    "react-dom": ">=19",
    "shiki": "^4.5.0",
    "tsdown": "^0.23.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.2"
  }
}
