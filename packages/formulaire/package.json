{
  "name": "formulaire-ui",
  "version": "0.4.0",
  "description": "A modern take on FormKeep's Gridforms: a CSS core for plain HTML, plus React components built on Base UI.",
  "author": "Matt Rothenberg",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mattrothenberg/formulaire.git",
    "directory": "packages/formulaire"
  },
  "homepage": "https://formulaire.mattrothenberg.com",
  "bugs": {
    "url": "https://github.com/mattrothenberg/formulaire/issues"
  },
  "type": "module",
  "keywords": [
    "react",
    "forms",
    "grid",
    "base-ui",
    "gridforms",
    "css"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./styles.css": "./dist/styles.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "sideEffects": [
    "*.css"
  ],
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "peerDependencies": {
    "@base-ui/react": "^1.0.0",
    "react": ">=19",
    "react-dom": ">=19"
  },
  "devDependencies": {
    "@arethetypeswrong/core": "^0.18.5",
    "@base-ui/react": "^1.8.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/browser-playwright": "5.0.3",
    "axe-core": "4.13.0",
    "playwright": "1.63.0",
    "publint": "^0.3.25",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tsdown": "^0.23.0",
    "typescript": "^7.0.2",
    "vitest": "5.0.3",
    "vitest-browser-react": "2.3.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
